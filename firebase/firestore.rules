rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFamilyMember(familyId) {
      let family = get(/databases/$(database)/documents/families/$(familyId)).data;
      return request.auth.uid in family.members;
    }

    // Check agency staff by reading the user's own profile rather than
    // the agency doc. This lets self-registered staff work without
    // needing an admin to update agency.staffUserIds first.
    function isAgencyStaff(agencyId) {
      let userData = getUserData();
      return userData.role == 'agency_staff' && userData.agencyId == agencyId;
    }

    function isPlatformAdmin() {
      let userData = getUserData();
      return userData.role == 'platform_admin';
    }

    // --- Users ---

    match /users/{userId} {
      // Users can read their own profile
      // Family members can read each other's profiles
      // Agency staff can read users linked to their agency
      // Platform admins can read all users (needed for agency admin info)
      allow read: if isOwner(userId)
        || (isSignedIn() && isPlatformAdmin())
        || (isSignedIn()
            && resource.data.familyId != null
            && isFamilyMember(resource.data.familyId))
        || (isSignedIn()
            && resource.data.familyId != null
            && isAgencyStaff(
                 get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.agencyId
               ));

      // Users can create their own profile during registration
      allow create: if isOwner(userId)
        && request.resource.data.role in ["personal", "user", "agency_staff", "agency_admin", "platform_admin"]
        && request.resource.data.email == request.auth.token.email;

      // Users can update their own profile.
      // Role can only change from "personal" (or legacy "user") to "family_admin" (when creating a family).
      allow update: if isOwner(userId)
        && (request.resource.data.role == resource.data.role
            || (resource.data.role in ["personal", "user"]
                && request.resource.data.role == "family_admin"));

      // Family admin can update another user's familyId and pendingFamilyId
      // when approving/rejecting a join request.
      // Field-level constraint: only familyId and pendingFamilyId can change.
      // familyId must match the pending family (prevents assigning to wrong family).
      allow update: if isSignedIn()
        && 'pendingFamilyId' in resource.data
        && resource.data.pendingFamilyId != null
        && get(/databases/$(database)/documents/families/$(resource.data.pendingFamilyId)).data.adminUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["familyId", "pendingFamilyId"])
        && (request.resource.data.familyId == resource.data.pendingFamilyId
            || request.resource.data.familyId == resource.data.familyId);

      // No client-side deletes
      allow delete: if false;
    }

    // --- Families ---

    match /families/{familyId} {
      // Family members and linked agency staff can read.
      // Any signed-in user can also read (needed for join-by-code lookup).
      allow read: if isSignedIn();

      // Any authenticated user can create a family if they set
      // themselves as admin and include themselves in members
      allow create: if isSignedIn()
        && request.resource.data.adminUserId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      // Only the family admin can update the family doc.
      // This prevents users from bypassing the join approval flow
      // by directly adding themselves to the members array.
      allow update: if isSignedIn()
        && resource.data.adminUserId == request.auth.uid;

      // No client-side deletes
      allow delete: if false;

      // --- Join Requests (subcollection) ---

      match /joinRequests/{requestId} {
        // Admin can read all requests; requester can read their own
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/families/$(familyId)).data.adminUserId == request.auth.uid
              || resource.data.userId == request.auth.uid);

        // Any authenticated user can create a request for themselves
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "pending";

        // Admin can approve/reject; requester can cancel their own.
        // userId field is locked (cannot be changed).
        allow update: if isSignedIn()
          && request.resource.data.userId == resource.data.userId
          && (
            // Admin approves or rejects
            (get(/databases/$(database)/documents/families/$(familyId)).data.adminUserId == request.auth.uid
             && request.resource.data.status in ["approved", "rejected"])
            ||
            // Requester cancels their own pending request
            (resource.data.userId == request.auth.uid
             && request.resource.data.status == "cancelled"
             && resource.data.status == "pending")
          );

        allow delete: if false;
      }
    }

    // --- Agencies ---

    match /agencies/{agencyId} {
      // Verified agencies readable by any signed-in user (for agency picker).
      // Staff can always read their own agency regardless of status.
      // Platform admins can read all agencies for verification workflow.
      allow read: if isSignedIn()
        && (resource.data.status == "verified"
            || isAgencyStaff(agencyId)
            || isPlatformAdmin());

      // Any authenticated user can create an agency with pending status
      // (agency signup flow on the web dashboard).
      allow create: if isSignedIn()
        && request.resource.data.status == "pending";

      // Platform admins can update agencies (verify/revoke status)
      allow update: if isSignedIn() && isPlatformAdmin();
      allow delete: if false;
    }

    // --- Alerts ---

    match /alerts/{alertId} {
      // Alert creator, family members, and linked agency staff can read
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isFamilyMember(resource.data.familyId)
            || isAgencyStaff(resource.data.agencyId));

      // Users can create alerts for themselves, or family members can
      // create alerts for other members (e.g. offline detection).
      allow create: if isSignedIn()
        && (request.resource.data.userId == request.auth.uid
            || (request.resource.data.familyId != null
                && isFamilyMember(request.resource.data.familyId)))
        && request.resource.data.type in ["panic", "ai_anomaly", "offline", "checkin"]
        && request.resource.data.status == "new";

      // Alert creator, family members, and agency staff can update alerts
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isFamilyMember(resource.data.familyId)
            || isAgencyStaff(resource.data.agencyId));

      // No client-side deletes
      allow delete: if false;
    }

    // --- Devices (Hardware Trackers) ---

    match /devices/{deviceId} {
      // Owner and family members can read device status
      allow read: if isSignedIn()
        && (resource.data.pairedUserId == request.auth.uid
            || (resource.data.familyId != null
                && isFamilyMember(resource.data.familyId)));

      // Only the paired user can create a device doc
      allow create: if isSignedIn()
        && request.resource.data.pairedUserId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      // Only the paired user can update (e.g. change label).
      // Cannot change pairedUserId (prevents hijacking).
      allow update: if isSignedIn()
        && resource.data.pairedUserId == request.auth.uid
        && request.resource.data.pairedUserId == resource.data.pairedUserId;

      // Only the paired user can delete (unpair)
      allow delete: if isSignedIn()
        && resource.data.pairedUserId == request.auth.uid;
    }

    // --- Location History ---

    match /locationHistory/{historyId} {
      // Owner, family members, and linked agency staff can read
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isFamilyMember(resource.data.familyId)
            || isAgencyStaff(
                 get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.agencyId
               ));

      // Only the user themselves can create their own history entries
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // No updates or deletes from clients
      allow update: if false;
      allow delete: if false;
    }
  }
}
